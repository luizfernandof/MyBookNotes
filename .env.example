# Copie para .env e preencha. O arquivo .env não vai para o git.

# Gere uma vez com: openssl rand -hex 32
# O banco guarda a senha na primeira inicialização; trocar aqui depois não altera a senha dele.
DB_PASSWORD=

# Gere uma vez com: openssl rand -base64 48
# Se mudar, os access tokens em uso deixam de valer (os usuários continuam logados pelo refresh token).
JWT_SECRET=

# Porta da VM que a VM de apontamento acessa
FRONT_PORT=8080

# Fuso usado no job de limpeza e nas datas de criação
TZ=America/Sao_Paulo
